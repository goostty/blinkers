{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "sql:default",
    "store:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "cursor:*"
        },
        {
          "url": "discord:*"
        },
        {
          "url": "evernote:*"
        },
        {
          "url": "figma:*"
        },
        {
          "url": "goodnotes:*"
        },
        {
          "url": "linear:*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "msteams:*"
        },
        {
          "url": "notability:*"
        },
        {
          "url": "notion:*"
        },
        {
          "url": "obsidian:*"
        },
        {
          "url": "onenote:*"
        },
        {
          "url": "postman:*"
        },
        {
          "url": "slack:*"
        },
        {
          "url": "spotify:*"
        },
        {
          "url": "steam:*"
        },
        {
          "url": "tg:*"
        },
        {
          "url": "todoist:*"
        },
        {
          "url": "vscode:*"
        },
        {
          "url": "whatsapp:*"
        },
        {
          "url": "zoommtg:*"
        },
        {
          "url": "zotero:*"
        }
      ]
    }
  ]
}
